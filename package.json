{
  "name": "owasp-nodejs-goat",
  "private": true,
  "version": "1.3.0",
  "description": "A tool to learn OWASP Top 10 for node.js developers",
  "main": "server.js",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "express": "^4.22.3",
    "express-session": "^1.18.1",
    "marked": "^4.3.0",
    "mongodb": "^3.7.4",
    "needle": "^3.3.1",
    "nunjucks": "^3.2.4",
    "serve-favicon": "^2.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "cross-env NODE_ENV=development PORT=5000 node server.js",
    "lint": "jshint app server.js config artifacts",
    "db:seed": "node artifacts/db-reset.js",
    "docker-mongo": "docker run -p 27017:27017 --name mongo mongo:4.4.29",
    "start-infra": "docker-compose up",
    "stop-infra": "docker-compose down"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jshint": "^2.13.6"
  },
  "repository": "https://github.com/OWASP/NodejsGoat",
